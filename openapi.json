{
  "openapi": "3.1.0",
  "info": {
    "title": "Prairie Connect API",
    "version": "0.1.0",
    "description": "API for the Prairie Connect rail logistics platform — directory/marketplace,\nuniversal search, corridor atlas, route finder, and the AI guide.\n\n**Auth**: integrate directly with the Cognito User Pool (Amplify Auth or\namazon-cognito-identity-js) and send the resulting JWT as a Bearer token.\n\n**Realtime**: fetch `/v1/realtime/token` for the MQTT-over-WSS config;\nchat replies stream there as `{type: delta|action|done}` events.\n\n**Chatbot UI actions**: assistant replies carry an `actions` array (see the\n`UiAction` schema) the client should execute — show a map, navigate, draw a\nroute, open directory results."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito JWT (id or access token). Sign in against the Cognito User Pool (see stack outputs userPoolId / userPoolClientId) and paste the token here."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "operator",
              "edo",
              "admin"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "DirectoryListing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "sector": {
            "type": "string",
            "enum": [
              "agrivalue",
              "lumber",
              "wind",
              "aggregates",
              "minerals",
              "logistics",
              "other"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "province": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending",
              "published",
              "archived"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "sector",
          "tags",
          "address",
          "city",
          "province",
          "verified",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateDirectoryListing": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "sector": {
            "type": "string",
            "enum": [
              "agrivalue",
              "lumber",
              "wind",
              "aggregates",
              "minerals",
              "logistics",
              "other"
            ],
            "default": "other"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "default": []
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "name"
        ]
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "province": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "score": {
            "type": "number"
          },
          "distanceKm": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "sector",
          "description",
          "city",
          "province",
          "verified",
          "score"
        ]
      },
      "Corridor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {}
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "operator",
          "description",
          "metrics",
          "createdAt"
        ]
      },
      "CorridorDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Corridor"
          },
          {
            "type": "object",
            "properties": {
              "geometry": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "geometry"
            ]
          }
        ]
      },
      "RouteResult": {
        "type": "object",
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteSegment"
            }
          },
          "totalLengthKm": {
            "type": "number"
          },
          "geometry": {
            "type": "object",
            "additionalProperties": {},
            "description": "GeoJSON FeatureCollection of the route edges"
          },
          "nearestOriginNode": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "distanceKm": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "distanceKm"
            ]
          },
          "nearestDestinationNode": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "distanceKm": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "distanceKm"
            ]
          }
        },
        "required": [
          "segments",
          "totalLengthKm",
          "geometry",
          "nearestOriginNode",
          "nearestDestinationNode"
        ]
      },
      "RouteSegment": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "number"
          },
          "edgeId": {
            "type": [
              "number",
              "null"
            ]
          },
          "mode": {
            "type": "string"
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "fromNode": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "toNode": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "lengthKm": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "seq",
          "edgeId",
          "mode",
          "operator",
          "fromNode",
          "toNode",
          "lengthKm"
        ]
      },
      "FindRouteRequest": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/RouteEndpoint"
          },
          "destination": {
            "$ref": "#/components/schemas/RouteEndpoint"
          },
          "reverse": {
            "type": "boolean",
            "default": false,
            "description": "Reverse routing (site -> markets) uses reverse cost weights"
          }
        },
        "required": [
          "origin",
          "destination"
        ]
      },
      "RouteEndpoint": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "SavedRoute": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/RouteEndpoint"
          },
          "destination": {
            "$ref": "#/components/schemas/RouteEndpoint"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteSegment"
            }
          },
          "geometry": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {}
          },
          "reverse": {
            "type": "boolean"
          },
          "curated": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "origin",
          "destination",
          "segments",
          "geometry",
          "reverse",
          "curated",
          "createdAt"
        ]
      },
      "SaveRouteRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FindRouteRequest"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "The assistant's text reply"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UiAction"
            },
            "description": "UI actions for the client to execute (show a map, navigate, draw a route...). Also streamed live on the conversation's realtime topic."
          }
        },
        "required": [
          "conversationId",
          "messageId",
          "message",
          "actions"
        ]
      },
      "UiAction": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "show_map"
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "center": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "Map center as [longitude, latitude]"
                  },
                  "zoom": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 8
                  },
                  "layers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [],
                    "description": "Layer ids to enable, e.g. 'corridor:<slug>', 'development-sites', 'transloads'"
                  }
                },
                "required": [
                  "center"
                ]
              }
            },
            "required": [
              "type",
              "payload"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "navigate"
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "App-relative path to send the user to, e.g. '/directory', '/route-finder', '/corridors/great-western'"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            "required": [
              "type",
              "payload"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "show_directory_results"
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "listingIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [],
                    "description": "Directory listing ids to display"
                  },
                  "filter": {
                    "type": "object",
                    "properties": {
                      "q": {
                        "type": "string"
                      },
                      "sector": {
                        "type": "string"
                      }
                    },
                    "description": "Filter to apply to the directory view"
                  }
                }
              }
            },
            "required": [
              "type",
              "payload"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "draw_route"
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "routeId": {
                    "type": "string",
                    "description": "A saved route id to display, if one exists"
                  },
                  "origin": {
                    "type": "object",
                    "properties": {
                      "lat": {
                        "type": "number"
                      },
                      "lng": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "lat",
                      "lng"
                    ]
                  },
                  "destination": {
                    "type": "object",
                    "properties": {
                      "lat": {
                        "type": "number"
                      },
                      "lng": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "lat",
                      "lng"
                    ]
                  }
                }
              }
            },
            "required": [
              "type",
              "payload"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "open_corridor_page"
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "description": "Corridor slug, e.g. 'great-western'"
                  }
                },
                "required": [
                  "slug"
                ]
              }
            },
            "required": [
              "type",
              "payload"
            ]
          }
        ]
      },
      "ChatRequest": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid",
            "description": "Omit to start a new conversation"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "message"
        ]
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "createdAt"
        ]
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UiAction"
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "actions",
          "createdAt"
        ]
      },
      "RealtimeConfig": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "IoT WSS endpoint host"
          },
          "authorizer": {
            "type": "string",
            "description": "IoT custom authorizer name"
          },
          "topicPrefix": {
            "type": "string"
          },
          "topics": {
            "type": "object",
            "properties": {
              "notifications": {
                "type": "string"
              },
              "chatPattern": {
                "type": "string",
                "description": "Chat topic; replace {conversationId}"
              }
            },
            "required": [
              "notifications",
              "chatPattern"
            ]
          }
        },
        "required": [
          "endpoint",
          "authorizer",
          "topicPrefix",
          "topics"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current user profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/directory": {
      "get": {
        "tags": [
          "Directory"
        ],
        "summary": "Browse published listings",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "agrivalue",
                "lumber",
                "wind",
                "aggregates",
                "minerals",
                "logistics",
                "other"
              ]
            },
            "required": false,
            "name": "sector",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "required": false,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Published directory listings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DirectoryListing"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Directory"
        ],
        "summary": "Submit a listing",
        "description": "Creates a listing in `pending` status. Admins move it to `published` after verification.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDirectoryListing"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryListing"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/directory/{idOrSlug}": {
      "get": {
        "tags": [
          "Directory"
        ],
        "summary": "Get one listing by id or slug",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "idOrSlug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryListing"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/directory/{id}": {
      "patch": {
        "tags": [
          "Directory"
        ],
        "summary": "Update a listing",
        "description": "Owners can edit their own listings; only admins can change `status` or `verified`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 5000
                  },
                  "sector": {
                    "type": "string",
                    "enum": [
                      "agrivalue",
                      "lumber",
                      "wind",
                      "aggregates",
                      "minerals",
                      "logistics",
                      "other"
                    ],
                    "default": "other"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 20,
                    "default": []
                  },
                  "address": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "province": {
                    "type": "string"
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "pending",
                      "published",
                      "archived"
                    ]
                  },
                  "verified": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryListing"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search the directory",
        "description": "Full-text + fuzzy search over published directory listings, with optional sector and geo-radius filters. `mode=semantic` uses vector similarity; `mode=hybrid` fuses both rankings.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": true,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "agrivalue",
                "lumber",
                "wind",
                "aggregates",
                "minerals",
                "logistics",
                "other"
              ]
            },
            "required": false,
            "name": "sector",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "required": false,
            "name": "lat",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            },
            "required": false,
            "name": "lng",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2000
            },
            "required": false,
            "name": "radiusKm",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "keyword",
                "semantic",
                "hybrid"
              ],
              "default": "keyword"
            },
            "required": false,
            "name": "mode",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked search hits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  }
                }
              }
            }
          }
        }
      }
    },
